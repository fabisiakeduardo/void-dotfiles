#!/usr/bin/env python3
"""Native VNC window for the dockur Windows 11 VM."""
import sys, subprocess

import gi

gi.require_version('Gtk', '3.0')
gi.require_version('GtkVnc', '2.0')
from gi.repository import Gtk, GtkVnc

CONTAINER = 'windows11'


def container_ip():
    try:
        return subprocess.check_output(
            ['docker', 'inspect', '-f',
             '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}',
             CONTAINER], text=True).strip()
    except Exception:
        return ''


HOST = sys.argv[1] if len(sys.argv) > 1 else container_ip() or '127.0.0.1'
PORT = sys.argv[2] if len(sys.argv) > 2 else '5900'

app = Gtk.Application(application_id='windows11')


def on_auth(disp, creds):
    for cred in creds:
        if cred == GtkVnc.DisplayCredential.PASSWORD:
            disp.set_credential(cred, 'admin')
        elif cred == GtkVnc.DisplayCredential.USERNAME:
            disp.set_credential(cred, 'eduardo')
    return True


def on_activate(app):
    win = Gtk.ApplicationWindow(application=app, title='Windows 11')
    win.set_default_size(1366, 768)
    win.set_icon_name('windows')

    disp = GtkVnc.Display()
    disp.set_scaling(True)
    disp.set_keyboard_grab(True)
    disp.set_pointer_grab(False)
    disp.set_pointer_local(True)

    disp.connect('vnc-disconnected', lambda *_: app.quit())
    disp.connect('vnc-auth-credential', on_auth)
    disp.connect('vnc-auth-failure', lambda *_: app.quit())

    win.add(disp)
    win.show_all()
    disp.grab_focus()
    disp.open_host(HOST, PORT)


app.connect('activate', on_activate)
app.run()
