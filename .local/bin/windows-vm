#!/bin/bash
# Windows 11 VM (dockur/windows) — omarchy-style launcher
# usage: windows-vm [launch|stop|status|console] [--keep-alive]

COMPOSE_FILE="$HOME/win11/docker-compose.yml"
CONTAINER="windows11"
LOG="/tmp/windows-vm.log"
CONSOLE="http://127.0.0.1:8006"

# RDP handshake probe: TCP alone isn't enough (docker-proxy accepts early),
# so send an X.224 negotiation request and expect a response.
rdp_ready() {
  python3 - <<'EOF' 2>/dev/null
import socket
s = socket.create_connection(('127.0.0.1', 3389), timeout=3)
s.sendall(bytes.fromhex('0300001311e000000000000100080003000000'))
resp = s.recv(19)
exit(0 if len(resp) >= 11 and resp[5] == 0xd0 else 1)
EOF
}

wait_boot() {
  local n=0
  until docker logs "$CONTAINER" 2>&1 | grep -qi "windows started successfully"; do
    sleep 3; (( ++n > 120 )) && return 1
  done
}

wait_rdp() {
  local n=0
  until rdp_ready; do
    sleep 5; (( ++n > 12 )) && return 1
  done
}

open_console() {
  zen-browser --new-window "$CONSOLE" >>"$LOG" 2>&1 &
}

launch() {
  if [[ ! -f $COMPOSE_FILE ]]; then
    notify-send -u critical "Windows VM" "Missing $COMPOSE_FILE"; exit 1
  fi

  if [[ $(docker inspect --format='{{.State.Status}}' "$CONTAINER" 2>/dev/null) != "running" ]]; then
    notify-send "Windows VM" "Starting — first boot can take a few minutes" -t 15000
    docker compose -f "$COMPOSE_FILE" up -d >>"$LOG" 2>&1 \
      || { notify-send -u critical "Windows VM" "Failed to start container"; exit 1; }
    wait_boot || { notify-send -u critical "Windows VM" "Boot timeout — see $CONSOLE"; exit 1; }
  fi

  # RDP is broken on Windows 11 25H2 (dockur issue #679) — go straight to
  # the noVNC console unless the guest's RDP stack already answers.
  if rdp_ready; then
    local scale rdp_scale=""
    scale=$(gsettings get org.gnome.desktop.interface scaling-factor 2>/dev/null | awk '{print $2}')
    [[ $scale =~ ^[0-9]+$ ]] && (( scale >= 2 )) && rdp_scale="/scale:180"

    local t0=$SECONDS
    xfreerdp3 /u:"eduardo" /p:"admin" /v:127.0.0.1:3389 -grab-keyboard \
      /sound /microphone /clipboard /cert:ignore /title:"Windows 11" \
      /dynamic-resolution /gfx:AVC444 \
      /floatbar:sticky:off,default:visible,show:fullscreen $rdp_scale \
      >>"$LOG" 2>&1
    local rc=$?

    # Fast exit = connect failure, not a real session — fall back to console.
    if (( SECONDS - t0 < 20 || rc != 0 )); then
      notify-send "Windows VM" "RDP unavailable — opening web console instead"
      open_console
      exit $rc
    fi

    [[ $1 = "-k" || $1 = "--keep-alive" ]] || {
      echo "RDP closed — stopping Windows VM..."
      docker compose -f "$COMPOSE_FILE" down >>"$LOG" 2>&1; }
  else
    notify-send "Windows VM" "Opening web console"
    open_console
  fi
}

case "$1" in
  launch) launch "$2" ;;
  stop) docker compose -f "$COMPOSE_FILE" down && echo "Windows VM stopped" ;;
  status)
    docker inspect --format='{{.Name}}: {{.State.Status}}' "$CONTAINER" 2>/dev/null || echo "not found"
    rdp_ready && echo "rdp: ready" || echo "rdp: not ready"
    ;;
  console) xdg-open "$CONSOLE" ;;
  *) echo "usage: windows-vm [launch [-k]|stop|status|console]" ;;
esac
